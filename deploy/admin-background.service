[Unit]
Description=admin-background 管理后台服务
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=admin-background
WorkingDirectory=/opt/admin-background
# conf 在前，application.properties 等配置从这里读取
ExecStart=/usr/bin/java -Xms256m -Xmx512m -cp /opt/admin-background/conf:/opt/admin-background/lib/* com.oaixdog.adminbackground.Application
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
